# Copier en .env (ou définir ces variables dans l'hébergeur). Aucune clé n'est exposée au navigateur.
PORT=3000
NODE_ENV=production
# Adresse publique du site (utilisée pour le sitemap, les balises Open Graph et les liens canoniques)
SITE_URL=https://www.gsports.ga
# Mettre 1 si le site est derrière un proxy/hébergeur qui fournit X-Forwarded-For
TRUST_PROXY=1
# Base PostgreSQL (Supabase). Sans cette variable : base PGlite locale dans data/pg
DATABASE_URL=postgresql://gsports_app.<projet>:<mot-de-passe>@aws-1-eu-west-3.pooler.supabase.com:6543/postgres
GSPORTS_UPLOADS=./data/uploads
# Sauvegardes quotidiennes automatiques de la base (7 conservées dans data/backups). 0 pour désactiver.
BACKUPS=1
